{
  "name": "gravador-de-tela",
  "version": "1.0.0",
  "description": "Gravador de tela simples para tutoriais rapidos",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "build": "electron-builder --win portable",
    "release": "node scripts/make-release.js"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "lucide-static": "^0.469.0",
    "ffmpeg-static": "^5.2.0"
  },
  "build": {
    "appId": "com.gravadordetela.app",
    "productName": "Gravador de Tela",
    "win": {
      "target": "portable",
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Gravador-de-Tela.exe"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      "build/icon.ico"
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**"
    ]
  }
}
